{% comment %}
  ── ReCarpet: Parse delivery dates from three sources (priority order) ──
  1. Custom attribute _confirmed_delivery_dates (copies from draft → order)
  2. Order metafield custom.confirmed_delivery_dates (JSON)
  3. Order notes (fallback)
{% endcomment %}
{% assign has_delivery_dates = false %}
{% assign delivery_lines_raw = "" | split: "" %}

{% comment %} SOURCE 1: Custom attribute {% endcomment %}
{% assign delivery_attr = order.attributes["_confirmed_delivery_dates"] %}
{% if delivery_attr != blank %}
  {% assign has_delivery_dates = true %}
  {% assign delivery_lines_raw = delivery_attr | strip | newline_to_br | split: "<br />" %}
{% endif %}

{% comment %} SOURCE 2: Order metafield JSON {% endcomment %}
{% unless has_delivery_dates %}
  {% assign delivery_meta = order.metafields.custom.confirmed_delivery_dates.value %}
  {% if delivery_meta != blank %}
    {% assign has_delivery_dates = true %}
    {% assign meta_items = delivery_meta.line_items %}
    {% capture delivery_text %}{% for item in meta_items %}{% if item.delivery_date != blank %}{% if item.variant != blank and item.variant != "" %}{{ item.title }} ({{ item.variant }}){% else %}{{ item.title }}{% endif %}: {{ item.delivery_date }}
{% endif %}{% endfor %}{% endcapture %}
    {% assign delivery_lines_raw = delivery_text | strip | newline_to_br | split: "<br />" %}
  {% endif %}
{% endunless %}

{% comment %} SOURCE 3: Order notes (fallback) {% endcomment %}
{% unless has_delivery_dates %}
  {% assign note_text = note | default: order.note %}
  {% if note_text contains "Bekräftade leveransdatum:" %}
    {% assign has_delivery_dates = true %}
    {% assign delivery_section = note_text | split: "Bekräftade leveransdatum:" | last %}
    {% assign delivery_lines_raw = delivery_section | strip | newline_to_br | split: "<br />" %}
  {% endif %}
{% endunless %}

{% if fulfillment.item_count == item_count %}
  {% capture email_title %}Din order är på väg{% endcapture %}
  {% capture email_body %}Din order är på väg. Spåra din försändelse för att se leveransstatusen.{% endcapture %}
{% elsif fulfillment.item_count > 1 %}
  {% if fulfillment_status == 'fulfilled' %}
    {% capture email_title %}De sista artiklarna i din order är på väg{% endcapture %}
    {% capture email_body %}De sista artiklarna i din order är på väg. Spåra din leverans för att se leveransstatus.{% endcapture %}
  {% else %}
    {% capture email_title %}Vissa artiklar i din order är på väg{% endcapture %}
    {% capture email_body %}Några artiklar i din order är på väg. Spåra din leverans för att se leveransstatus.{% endcapture %}
  {% endif %}
{% else %}
  {% if fulfillment_status == 'fulfilled' %}
    {% capture email_title %}Den sista artikeln i din order är på väg{% endcapture %}
    {% capture email_body %}Den sista artikeln i din order är på väg. Spåra din leverans för att se leveransstatus.{% endcapture %}
  {% else %}
    {% capture email_title %}En artikel i din order är på väg{% endcapture %}
    {% capture email_body %}En artikel i din order är på väg. Spåra din leverans för att se leveransstatus.{% endcapture %}
  {% endif %}
{% endif %}
{% capture email_emphasis %}Beräknat leveransdatum: <strong>{{fulfillment.estimated_delivery_at | date: format: 'date'}}</strong>{% endcapture %}
<!DOCTYPE html>
