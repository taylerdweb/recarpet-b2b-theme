              Beräknad leverans: {{ fulfillment.estimated_delivery_at | date: format: 'date' }}
            </span><br/>
          {% endif %}
          {% if false %}
            {% for child_line in line.line_item.bundle_components %}

{% if true %}
  {% assign css_class = 'order-list__bundle-item' %}
  {% assign css_image_class = 'order-list__image-cell' %}
