                  <p style="margin: 0 0 10px; font-size: 14px; font-weight: 600; color: #1e4433;">Fakturauppgifter</p>
                  <table cellpadding="0" cellspacing="0" border="0" width="100%">
                    {% if rc_orgnr != blank %}
                    <tr>
                      <td style="padding: 3px 0; font-size: 13px; color: #888; width: 140px; vertical-align: top;">Org.nr</td>
                      <td style="padding: 3px 0; font-size: 13px; color: #333;">{{ rc_orgnr }}</td>
                    </tr>
                    {% endif %}
                    {% if rc_fepost != blank %}
                    <tr>
                      <td style="padding: 3px 0; font-size: 13px; color: #888; width: 140px; vertical-align: top;">Faktura-e-post</td>
                      <td style="padding: 3px 0; font-size: 13px; color: #333;">{{ rc_fepost }}</td>
                    </tr>
                    {% endif %}
                    {% if rc_ref != blank %}
                    <tr>
                      <td style="padding: 3px 0; font-size: 13px; color: #888; width: 140px; vertical-align: top;">Referensnummer</td>
                      <td style="padding: 3px 0; font-size: 13px; color: #333;">{{ rc_ref }}</td>
                    </tr>
                    {% endif %}
                    {% if rc_mark != blank %}
                    <tr>
                      <td style="padding: 3px 0; font-size: 13px; color: #888; width: 140px; vertical-align: top;">Märkning</td>
                      <td style="padding: 3px 0; font-size: 13px; color: #333;">{{ rc_mark }}</td>
                    </tr>
                    {% endif %}
                  </table>
                </td>
              </tr>
            </table>
            {% endif %}

            <!-- CTA: Mitt konto via SparkLayer (ersätter Shopify order status + Shop Pay) -->
