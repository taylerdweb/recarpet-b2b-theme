              {% if dl_stripped != "" and dl_stripped contains ": " %}
                {% assign dl_parts = dl_stripped | split: ": " %}
                {% assign dl_item = dl_parts | first %}
                {% assign dl_date = dl_parts | last %}
                {% if dl_item contains line_title or line_title contains dl_item %}
                  <span class="order-list__item-variant" style="color: #1e4433; font-weight: 600;">
                    Leveransdatum: {{ dl_date }}
