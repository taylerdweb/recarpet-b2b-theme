{%- comment -%}
  rc-guest-banner.liquid
  ------------------------------------------------------------------
  Banner shown to logged-in customers whose account is still under review
  (has `guest` tag or is missing the `member` tag). Invisible for fully
  logged-out visitors and for approved members.

  Rendered near the top of every page — include from layout/theme.liquid
  just inside <body>.
{%- endcomment -%}

{%- liquid
  assign _rc_tags = customer.tags | join: ',' | downcase
  assign rc_is_guest = false
  assign rc_is_logged_in_guest = false
  assign rc_is_member = false
  assign rc_is_plus = false
  assign rc_is_premium = false
  assign rc_is_krets = false
  unless customer
    assign rc_is_guest = true
    assign rc_tier = 'guest'
  else
    if _rc_tags contains 'b2b-premium-'
      assign rc_is_premium = true
      assign rc_is_plus = true
      assign rc_is_member = true
      assign rc_tier = 'premium'
      if _rc_tags contains 'krets'
        assign rc_is_krets = true
      endif
    elsif _rc_tags contains 'b2b-plus-'
      assign rc_is_plus = true
      assign rc_is_member = true
      assign rc_tier = 'plus'
    elsif _rc_tags contains 'b2b-member-'
      assign rc_is_member = true
      assign rc_tier = 'member'
    else
      assign rc_is_guest = true
      assign rc_is_logged_in_guest = true
      assign rc_tier = 'guest'
    endif
  endunless
  assign rc_can_buy_batches = rc_is_plus
  assign rc_can_buy_reused = rc_is_member
  assign rc_sees_services = rc_is_premium
  assign rc_can_add_montering = rc_is_premium
-%}

{%- if rc_is_logged_in_guest -%}
  <div class="rc-guest-banner" role="status">
    <div class="rc-guest-banner__inner">
      <span class="rc-guest-banner__text">
        Ditt konto granskas — reCarpet ser över din ansökan och
        aktiverar köpmöjligheten inom kort. Under tiden kan du bläddra
        i hela vårt sortiment.
      </span>
      <a class="rc-guest-banner__link" href="/pages/kontakta-oss">Kontakta oss</a>
    </div>
  </div>

  <style>
    .rc-guest-banner {
      background: var(--rc-green, #1e4433);
      color: #fff;
      font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
      font-size: 0.8125rem !important; /* 13px */
      font-weight: 400 !important;
      line-height: 1.5 !important;
      letter-spacing: 0.01em;
      padding: 0.625rem 1rem; /* 10px 16px */
      text-align: center;
    }
    .rc-guest-banner__text,
    .rc-guest-banner__link {
      font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
      font-size: 0.8125rem !important; /* 13px */
      color: #fff !important;
    }
    .rc-guest-banner__inner {
      max-width: 68.75rem; /* 1100px */
      margin: 0 auto;
      display: flex;
      gap: 0.75rem; /* 12px */
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
    }
    .rc-guest-banner__link {
      text-decoration: underline;
      text-underline-offset: 2px;
      white-space: nowrap;
      font-weight: 500 !important;
    }
    .rc-guest-banner__link:hover { opacity: 0.85; }
  </style>
{%- endif -%}
