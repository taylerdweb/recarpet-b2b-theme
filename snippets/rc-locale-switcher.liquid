{%- comment -%}
  rc-locale-switcher.liquid
  ------------------------------------------------------------------
  Combined market/language switcher with inline SVG flags.
  Each option sets BOTH country (currency) and language simultaneously
  by submitting the Shopify localization form.

  Usage:
    {% render 'rc-locale-switcher', position: 'header' %}
{%- endcomment -%}

{%- assign _current_country = localization.country.iso_code -%}
{%- assign _current_lang    = localization.language.iso_code -%}

{%- comment -%}
  SVG flag snippets — flat 4:3 rectangles, 20×15 with 2px radius.
  Kept minimal for inline use.
{%- endcomment -%}
{%- capture flag_SE -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#006AA7"/><rect x="6" width="3" height="15" fill="#FECC02"/><rect y="6" width="20" height="3" fill="#FECC02"/></svg>{%- endcapture -%}
{%- capture flag_NO -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#EF2B2D"/><rect x="6" width="3" height="15" fill="#002868"/><rect y="6" width="20" height="3" fill="#002868"/><rect x="6.5" width="2" height="15" fill="#fff"/><rect y="6.5" width="20" height="2" fill="#fff"/></svg>{%- endcapture -%}
{%- capture flag_DK -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#C8102E"/><rect x="6" width="2.5" height="15" fill="#fff"/><rect y="6.25" width="20" height="2.5" fill="#fff"/></svg>{%- endcapture -%}
{%- capture flag_FI -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#fff"/><rect x="6" width="3" height="15" fill="#003580"/><rect y="6" width="20" height="3" fill="#003580"/></svg>{%- endcapture -%}
{%- capture flag_DE -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#FFCC00"/><rect width="20" height="5" rx="2" fill="#000"/><rect y="5" width="20" height="5" fill="#DD0000"/></svg>{%- endcapture -%}
{%- capture flag_NL -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#21468B"/><rect width="20" height="5" rx="2" fill="#AE1C28"/><rect y="5" width="20" height="5" fill="#fff"/></svg>{%- endcapture -%}
{%- capture flag_GB -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#012169"/><path d="M0,0 L20,15 M20,0 L0,15" stroke="#fff" stroke-width="2.5"/><path d="M0,0 L20,15 M20,0 L0,15" stroke="#C8102E" stroke-width="1.5"/><rect x="8" width="4" height="15" fill="#fff"/><rect y="5.5" width="20" height="4" fill="#fff"/><rect x="8.75" width="2.5" height="15" fill="#C8102E"/><rect y="6" width="20" height="3" fill="#C8102E"/></svg>{%- endcapture -%}
{%- capture flag_GLOBE -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#e5e5e5"/><circle cx="10" cy="7.5" r="5" fill="none" stroke="#999" stroke-width="1"/><ellipse cx="10" cy="7.5" rx="2.5" ry="5" fill="none" stroke="#999" stroke-width="0.8"/><line x1="5" y1="7.5" x2="15" y2="7.5" stroke="#999" stroke-width="0.8"/></svg>{%- endcapture -%}

{%- comment -%} Map current country to flag + label {%- endcomment -%}
{%- case _current_country -%}
  {%- when 'SE' -%}{%- assign _flag = flag_SE -%}{%- assign _label = 'SE' -%}
  {%- when 'NO' -%}{%- assign _flag = flag_NO -%}{%- assign _label = 'NO' -%}
  {%- when 'DK' -%}{%- assign _flag = flag_DK -%}{%- assign _label = 'DK' -%}
  {%- when 'FI' -%}{%- assign _flag = flag_FI -%}{%- assign _label = 'FI' -%}
  {%- when 'DE' -%}{%- assign _flag = flag_DE -%}{%- assign _label = 'DE' -%}
  {%- when 'NL' -%}{%- assign _flag = flag_NL -%}{%- assign _label = 'NL' -%}
  {%- when 'GB' -%}{%- assign _flag = flag_GB -%}{%- assign _label = 'GB' -%}
  {%- else -%}{%- assign _flag = flag_GLOBE -%}{%- assign _label = _current_country -%}
{%- endcase -%}

<div class="rc-locale" data-rc-locale>
  <button
    type="button"
    class="rc-locale__trigger"
    aria-expanded="false"
    aria-haspopup="listbox"
  >
    <span class="rc-locale__flag">{{ _flag }}</span>
    <span class="rc-locale__code">{{ _label }}</span>
    <svg class="rc-locale__caret" width="8" height="6" viewBox="0 0 8 6" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1 1.5L4 4.5L7 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="rc-locale__dropdown" hidden>
    <ul class="rc-locale__list" role="listbox">
      {%- for country in localization.available_countries -%}
        {%- case country.iso_code -%}
          {%- when 'SE' -%}{%- assign _c_flag = flag_SE -%}{%- assign _c_name = 'Sverige' -%}
          {%- when 'NO' -%}{%- assign _c_flag = flag_NO -%}{%- assign _c_name = 'Norge' -%}
          {%- when 'DK' -%}{%- assign _c_flag = flag_DK -%}{%- assign _c_name = 'Danmark' -%}
          {%- when 'FI' -%}{%- assign _c_flag = flag_FI -%}{%- assign _c_name = 'Finland' -%}
          {%- when 'DE' -%}{%- assign _c_flag = flag_DE -%}{%- assign _c_name = 'Deutschland' -%}
          {%- when 'NL' -%}{%- assign _c_flag = flag_NL -%}{%- assign _c_name = 'Nederland' -%}
          {%- when 'GB' -%}{%- assign _c_flag = flag_GB -%}{%- assign _c_name = 'United Kingdom' -%}
          {%- else -%}{%- assign _c_flag = flag_GLOBE -%}{%- assign _c_name = country.name -%}
        {%- endcase -%}
        {%- assign _is_active = false -%}
        {%- if country.iso_code == _current_country -%}{%- assign _is_active = true -%}{%- endif -%}
        <li>
          <button
            type="button"
            class="rc-locale__option{% if _is_active %} rc-locale__option--active{% endif %}"
            role="option"
            aria-selected="{% if _is_active %}true{% else %}false{% endif %}"
            data-country-code="{{ country.iso_code }}"
            {%- comment -%} Auto-map country → language for combined switcher {%- endcomment -%}
            {%- case country.iso_code -%}
              {%- when 'DK' -%}{%- assign _mapped_lang = 'da' -%}
              {%- when 'DE' -%}{%- assign _mapped_lang = 'de' -%}
              {%- when 'NL' -%}{%- assign _mapped_lang = 'nl' -%}
              {%- when 'GB' -%}{%- assign _mapped_lang = 'en' -%}
              {%- else -%}{%- assign _mapped_lang = 'sv' -%}
            {%- endcase -%}
            data-locale-code="{{ _mapped_lang }}"
          >
            <span class="rc-locale__flag">{{ _c_flag }}</span>
            <span class="rc-locale__option-name">{{ _c_name }}</span>
            {%- unless customer -%}
              <span class="rc-locale__option-currency">{{ country.currency.iso_code }}</span>
            {%- endunless -%}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  /* ---- Combined locale switcher ---- */
  .rc-locale {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .rc-locale__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.375rem 0.5rem;
    border-radius: var(--rc-radius-sm, 4px);
    font-family: var(--rc-font, inherit);
    font-size: 1rem;
    font-weight: 500;
    color: var(--rc-off-black, #1a1a1a);
    line-height: 120%;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .rc-locale__trigger:hover {
    opacity: 0.7;
  }

  /* SVG flag sizing */
  .rc-flag {
    width: 20px;
    height: 15px;
    display: block;
    flex-shrink: 0;
  }
  .rc-locale__flag {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .rc-locale__code {
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }
  .rc-locale__caret {
    width: 8px;
    height: 6px;
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  .rc-locale[data-open] .rc-locale__caret {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .rc-locale__dropdown {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    z-index: 100;
    background: var(--rc-white, #fff);
    border: 1px solid var(--rc-beige, #e0ddd7);
    border-radius: var(--rc-radius-sm, 6px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    min-width: 200px;
    padding: 0.35rem 0;
    animation: rcLocaleIn 0.15s ease;
  }
  @keyframes rcLocaleIn {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .rc-locale__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rc-locale__option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.55rem 1rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--rc-font, inherit);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--rc-off-black, #1a1a1a);
    transition: background 0.1s;
    text-align: left;
    white-space: nowrap;
  }
  .rc-locale__option:hover {
    background: var(--rc-cream, #F0EFEB);
  }
  .rc-locale__option--active {
    font-weight: 600;
  }
  .rc-locale__option-currency {
    margin-left: auto;
    color: rgba(0,0,0,0.45);
    font-size: 0.8rem;
  }

  /* ---- Transparent header (over hero) — white text ---- */
  .header-wrapper--transparent .rc-locale__trigger {
    color: #fff;
  }
  .header-wrapper--transparent .rc-locale__caret {
    color: #fff;
  }
  .header-wrapper--transparent .rc-locale__trigger:hover {
    opacity: 0.7;
  }
</style>

<script>
  (function() {
    document.querySelectorAll('[data-rc-locale]').forEach(function(root) {
      var trigger  = root.querySelector('.rc-locale__trigger');
      var dropdown = root.querySelector('.rc-locale__dropdown');

      trigger.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = root.hasAttribute('data-open');
        if (open) {
          close();
        } else {
          dropdown.hidden = false;
          root.setAttribute('data-open', '');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });

      function close() {
        dropdown.hidden = true;
        root.removeAttribute('data-open');
        trigger.setAttribute('aria-expanded', 'false');
      }

      document.addEventListener('click', function() { close(); });
      dropdown.addEventListener('click', function(e) { e.stopPropagation(); });

      /* On option click → submit Shopify country + language form */
      root.querySelectorAll('.rc-locale__option').forEach(function(opt) {
        opt.addEventListener('click', function() {
          var countryCode = opt.getAttribute('data-country-code');
          var localeCode  = opt.getAttribute('data-locale-code');
          /* Find the Shopify localization form in the header and submit it */
          var form = document.getElementById('HeaderCountryForm') ||
                     document.querySelector('form[action*="/localization"]');
          if (form) {
            /* Set country_code */
            var countryInput = form.querySelector('input[name="country_code"]');
            if (!countryInput) {
              countryInput = document.createElement('input');
              countryInput.type = 'hidden';
              countryInput.name = 'country_code';
              form.appendChild(countryInput);
            }
            countryInput.value = countryCode;

            /* Set locale_code (language) */
            if (localeCode) {
              var langInput = form.querySelector('input[name="locale_code"]');
              if (!langInput) {
                langInput = document.createElement('input');
                langInput.type = 'hidden';
                langInput.name = 'locale_code';
                form.appendChild(langInput);
              }
              langInput.value = localeCode;
            }

            form.submit();
          }
        });
      });
    });
  })();
</script>
