{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {% assign showB2BNav = false %}
              
              {%- if showB2BNav == true -%}

                {%- if customer.metafields.sparklayer.authentication -%}
                  {% assign menu = linklists.b2b-menu | default: linklists[section.settings.menu] %}
                {%- else -%}
                  {% assign menu = linklists[section.settings.menu] %}
                {%- endif -%}

              {%- else -%}
  
                {% assign menu = linklists[section.settings.menu] %}

              {%- endif -%}

            {%- for link in menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      >
                        {{ link.title | escape }}
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            {{ link.title | escape }}
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                    >
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>
                                    <div
                                      id="childlink-{{ childlink.handle | escape }}"
                                      class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                    >
                                      <button
                                        class="menu-drawer__close-button link link--text focus-inset"
                                        aria-expanded="true"
                                      >
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul
                                        class="menu-drawer__menu list-menu"
                                        role="list"
                                        tabindex="-1"
                                      >
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
              {%- assign customer_tags_lower = customer.tags | join: ',' | downcase -%}
              {%- unless customer_tags_lower contains 'member' -%}
                <li>
                  <a
                    id="HeaderDrawer-b2b-login"
                    href="/pages/b2b-login"
                    class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                  >
                    B2B-inloggning
                  </a>
                </li>
              {%- endunless -%}
            </ul>
          </nav>
          <div class="menu-drawer__utility-links">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="menu-drawer__account link focus-inset h5 medium-hide large-up-hide"
                rel="nofollow"
              >
                {%- if section.settings.enable_customer_avatar -%}
                  <account-icon>
                    {%- if customer and customer.has_avatar? -%}
                      {{ customer | avatar }}
                    {%- else -%}
                      <span class="svg-wrapper">
                        {{- 'icon-account.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}
                  </account-icon>
                {%- else -%}
                  <span class="svg-wrapper">
                    {{- 'icon-account.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </a>
            {%- endif -%}
            {%- comment -%} reCarpet: mobile flag-based locale switcher — inline flags, no dropdown {%- endcomment -%}
            {%- if localization.available_countries and localization.available_countries.size > 1 -%}
              <div class="menu-drawer__localization header-localization" style="padding: 20px 30px;">
                {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                  <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
                  <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
                {%- endform -%}

                {%- capture flag_SE -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#006AA7"/><rect x="6" width="3" height="15" fill="#FECC02"/><rect y="6" width="20" height="3" fill="#FECC02"/></svg>{%- endcapture -%}
                {%- capture flag_NO -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#EF2B2D"/><rect x="6" width="3" height="15" fill="#002868"/><rect y="6" width="20" height="3" fill="#002868"/><rect x="6.5" width="2" height="15" fill="#fff"/><rect y="6.5" width="20" height="2" fill="#fff"/></svg>{%- endcapture -%}
                {%- capture flag_DK -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#C8102E"/><rect x="6" width="2.5" height="15" fill="#fff"/><rect y="6.25" width="20" height="2.5" fill="#fff"/></svg>{%- endcapture -%}
                {%- capture flag_FI -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#fff"/><rect x="6" width="3" height="15" fill="#003580"/><rect y="6" width="20" height="3" fill="#003580"/></svg>{%- endcapture -%}
                {%- capture flag_DE -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#FFCC00"/><rect width="20" height="5" rx="2" fill="#000"/><rect y="5" width="20" height="5" fill="#DD0000"/></svg>{%- endcapture -%}
                {%- capture flag_NL -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#21468B"/><rect width="20" height="5" rx="2" fill="#AE1C28"/><rect y="5" width="20" height="5" fill="#fff"/></svg>{%- endcapture -%}
                {%- capture flag_GB -%}<svg class="rc-flag" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="15" rx="2" fill="#012169"/><path d="M0,0 L20,15 M20,0 L0,15" stroke="#fff" stroke-width="2.5"/><path d="M0,0 L20,15 M20,0 L0,15" stroke="#C8102E" stroke-width="1.5"/><rect x="8" width="4" height="15" fill="#fff"/><rect y="5.5" width="20" height="4" fill="#fff"/><rect x="8.75" width="2.5" height="15" fill="#C8102E"/><rect y="6" width="20" height="3" fill="#C8102E"/></svg>{%- endcapture -%}

                <div class="rc-locale-mobile" data-rc-locale-mobile>
                  <div class="rc-locale-mobile__flags">
                    {%- for country in localization.available_countries -%}
                      {%- case country.iso_code -%}
                        {%- when 'SE' -%}{%- assign _mflag = flag_SE -%}{%- assign _mlabel = 'SE' -%}{%- assign _mlang = 'sv' -%}
                        {%- when 'NO' -%}{%- assign _mflag = flag_NO -%}{%- assign _mlabel = 'NO' -%}{%- assign _mlang = 'sv' -%}
                        {%- when 'DK' -%}{%- assign _mflag = flag_DK -%}{%- assign _mlabel = 'DK' -%}{%- assign _mlang = 'da' -%}
                        {%- when 'FI' -%}{%- assign _mflag = flag_FI -%}{%- assign _mlabel = 'FI' -%}{%- assign _mlang = 'sv' -%}
                        {%- when 'DE' -%}{%- assign _mflag = flag_DE -%}{%- assign _mlabel = 'DE' -%}{%- assign _mlang = 'de' -%}
                        {%- when 'NL' -%}{%- assign _mflag = flag_NL -%}{%- assign _mlabel = 'NL' -%}{%- assign _mlang = 'nl' -%}
                        {%- when 'GB' -%}{%- assign _mflag = flag_GB -%}{%- assign _mlabel = 'GB' -%}{%- assign _mlang = 'en' -%}
                        {%- else -%}{%- assign _mflag = '' -%}{%- assign _mlabel = country.iso_code -%}{%- assign _mlang = 'sv' -%}
                      {%- endcase -%}
                      <button
                        type="button"
                        class="rc-locale-mobile__flag-btn{% if country.iso_code == localization.country.iso_code %} rc-locale-mobile__flag-btn--active{% endif %}"
                        data-country-code="{{ country.iso_code }}"
                        data-locale-code="{{ _mlang }}"
                        aria-label="{{ _mlabel }}"
                      >
                        <span class="rc-locale-mobile__flag">{{ _mflag }}</span>
                        <span class="rc-locale-mobile__label">{{ _mlabel }}</span>
                      </button>
                    {%- endfor -%}
                  </div>
                </div>

                <style>
                  .rc-locale-mobile__flags {
                    display: flex;
                    gap: 0.5rem;
                    flex-wrap: wrap;
                  }
                  .rc-locale-mobile__flag-btn {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.35rem;
                    padding: 0.5rem 0.75rem;
                    background: transparent;
                    border: 1px solid #ddd;
                    border-radius: 6px;
                    cursor: pointer;
                    font-family: var(--rc-font, 'DM Sans', sans-serif);
                    font-size: 0.8rem;
                    font-weight: 500;
                    color: var(--rc-off-black, #1a1a1a);
                    transition: border-color 0.15s, background 0.15s;
                  }
                  .rc-locale-mobile__flag-btn:hover {
                    border-color: #aaa;
                  }
                  .rc-locale-mobile__flag-btn--active {
                    border-color: var(--rc-green, #1e4433);
                    background: rgba(30, 68, 51, 0.06);
                    font-weight: 600;
                  }
                  .rc-locale-mobile__flag .rc-flag {
                    width: 20px;
                    height: 15px;
                    display: block;
                  }
                </style>

                <script>
                  (function() {
                    document.querySelectorAll('[data-rc-locale-mobile]').forEach(function(root) {
                      root.querySelectorAll('.rc-locale-mobile__flag-btn').forEach(function(btn) {
                        btn.addEventListener('click', function() {
                          var form = root.closest('.menu-drawer__localization').querySelector('form[action*="/localization"]');
                          if (!form) return;
                          var countryInput = form.querySelector('input[name="country_code"]');
                          var langInput = form.querySelector('input[name="locale_code"]');
                          if (countryInput) countryInput.value = btn.getAttribute('data-country-code');
                          if (langInput) langInput.value = btn.getAttribute('data-locale-code');
                          form.submit();
                        });
                      });
                    });
                  })();
                </script>
              </div>
            {%- endif -%}
            <ul class="list list-social list-unstyled" role="list">
              {%- if settings.social_twitter_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-twitter.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-facebook.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-pinterest.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-instagram.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tiktok.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tumblr_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tumblr.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_snapchat_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-snapchat.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-youtube.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_vimeo_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-vimeo.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
