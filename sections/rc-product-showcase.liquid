{% comment %}
  reCarpet Product Showcase
  Uses the standard card-product snippet in a clean white-background grid
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

<style>
  .rc-product-showcase {
    background: #fff;
    padding: var(--rc-section-md) 0;
  }
  .rc-product-showcase__inner {
    max-width: var(--rc-max-width);
    margin: 0 auto;
    padding: 0 var(--rc-page-padding);
  }
  h2.rc-product-showcase__heading {
    text-align: center;
    font-family: var(--recarpet-dm-sans);
    font-size: clamp(1.75rem, 3.5vw, var(--rc-h3));
    font-weight: 500;
    line-height: 120%;
    margin: 0 0 5rem;
    color: var(--base-color-brand--rc-off-black);
  }
  .rc-product-showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 2.5rem;
    row-gap: 3rem;
  }
  /* Equal-height card content alignment */
  .rc-product-showcase__grid .card__heading {
    min-height: 2.8em;
  }
  .rc-product-showcase__viewall {
    text-align: center;
    margin-top: 3rem;
  }
  .rc-product-showcase__viewall a {
    font-family: var(--recarpet-dm-sans);
    font-size: 1rem;
    font-weight: 500;
    color: #fff;
    background: var(--rc-green, #1e4433);
    padding: 0.85rem 2.5rem;
    border-radius: var(--rc-radius);
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.2s;
  }
  .rc-product-showcase__viewall a:hover {
    opacity: 0.85;
  }
  /* Tighten Bli medlem CTA spacing (mirrors collection grid fix) */
  .rc-product-showcase__grid .card__cta-logged-out {
    margin-top: -0.5rem;
    margin-bottom: -0.5rem;
  }
  .rc-product-showcase__grid .card__content:has(.card__cta-logged-out) .card__information {
    padding-bottom: 0.25rem;
  }
  @media (max-width: 989px) {
    .rc-product-showcase__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .rc-product-showcase__inner { padding: 0 1.25rem; }
  }
</style>

<section class="rc-product-showcase">
  <div class="rc-product-showcase__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="rc-product-showcase__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="rc-product-showcase__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          {%- render 'card-product',
            card_product: block.settings.product,
            media_aspect_ratio: 'square',
            image_shape: 'default',
            show_secondary_image: false,
            show_vendor: true,
            show_rating: false,
            lazy_load: true,
            skip_styles: true,
            section_id: section.id,
            quick_add: 'none'
          -%}
        {%- else -%}
          {%- render 'card-product',
            media_aspect_ratio: 'square',
            image_shape: 'default',
            show_vendor: true,
            show_rating: false,
            lazy_load: true,
            skip_styles: true,
            section_id: section.id
          -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.view_all_url != blank -%}
      <div class="rc-product-showcase__viewall">
        <a href="{{ section.settings.view_all_url }}">{{ section.settings.view_all_text | default: 'Se alla produkter' }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "reCarpet Produkter",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Utvalda produkter"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Visa 'Se alla' knapp",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Knapp länk"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Knapptext",
      "default": "Se alla produkter"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produkt",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Välj produkt"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "reCarpet Produkter",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
