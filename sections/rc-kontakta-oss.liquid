{% comment %}
  reCarpet Kontakta oss — Contact page section
  Matches Webflow design: recarpet.se/kontakta-oss
{% endcomment %}

<style>
  .rc-contact-page {
    background: var(--rc-cream, #f5f3ef);
    padding: var(--rc-section-md) 0;
  }
  .rc-contact-page__inner {
    max-width: var(--rc-max-width);
    margin: 0 auto;
    padding: 0 var(--rc-page-padding);
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 5rem !important;
    align-items: start !important;
  }

  /* Left: Contact info */
  .rc-contact-page__info-heading {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 3rem !important;
    font-weight: 500 !important;
    line-height: 120% !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 0 1.25rem !important;
  }
  .rc-contact-page__info-body {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1.125rem !important;
    line-height: 1.5 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 0 2.5rem !important;
  }

  .rc-contact-blocks {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .rc-contact-block {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .rc-contact-block__icon {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .rc-contact-block__icon svg {
    width: 1.25rem;
    height: 1.25rem;
    stroke: var(--rc-off-black, #1a1a1a);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rc-contact-block__value {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1rem !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    font-weight: 400 !important;
  }
  .rc-contact-block__value a {
    color: var(--rc-off-black, #1a1a1a) !important;
    text-decoration: none !important;
  }
  .rc-contact-block__value a:hover {
    text-decoration: underline !important;
  }

  /* Contact persons — in left column */
  .rc-contact-persons {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .rc-contact-person {
    display: flex;
    flex-direction: column;
  }
  .rc-contact-person__photo {
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  .rc-contact-person__photo img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }
  .rc-contact-person__name {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1.25rem !important;
    font-weight: 600 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 0 0.125rem !important;
  }
  .rc-contact-person__title {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1rem !important;
    font-weight: 400 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 0 1rem !important;
  }
  .rc-contact-person__phone {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1rem !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 0 0.25rem !important;
  }
  .rc-contact-person__phone a {
    color: var(--rc-off-black, #1a1a1a) !important;
    text-decoration: none !important;
  }
  .rc-contact-person__phone a:hover { text-decoration: underline !important; }
  .rc-contact-person__email {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1rem !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 !important;
  }
  .rc-contact-person__email a {
    color: var(--rc-off-black, #1a1a1a) !important;
    text-decoration: none !important;
  }
  .rc-contact-person__email a:hover { text-decoration: underline !important; }

  /* Right: Form */
  .rc-contact-form-wrap {
    background: transparent;
    padding: 0;
  }
  .rc-contact-form-wrap h3 {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1.5rem !important;
    font-weight: 500 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 0 1.5rem !important;
  }
  .rc-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .rc-form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }
  .rc-form-group--full { grid-column: 1 / -1; }
  .rc-form-group label {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 0.875rem !important;
    font-weight: 600 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
  }
  .rc-form-group input,
  .rc-form-group select,
  .rc-form-group textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--rc-off-black, #1a1a1a) !important;
    border-radius: 2px;
    font-size: 0.875rem;
    font-family: var(--rc-font, 'DM Sans', sans-serif);
    color: var(--rc-off-black, #1a1a1a);
    background: transparent !important;
    outline: none;
    transition: border-color 0.15s;
    box-sizing: border-box;
    -webkit-appearance: none;
  }
  .rc-form-group input::placeholder,
  .rc-form-group textarea::placeholder {
    color: #999 !important;
    opacity: 1 !important;
  }
  .rc-form-group input:focus,
  .rc-form-group select:focus,
  .rc-form-group textarea:focus {
    border-color: var(--rc-green, #1e4433) !important;
  }
  .rc-form-group textarea { resize: vertical; min-height: 7.5rem; }

  /* Radio button group — styled as clickable boxes */
  .rc-radio-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .rc-radio-group__label {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 0.875rem !important;
    font-weight: 600 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin-bottom: 0.5rem;
    font-style: italic;
  }
  .rc-radio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .rc-radio-option {
    display: flex;
    align-items: center;
  }
  .rc-radio-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .rc-radio-option label {
    margin: 0 !important;
    cursor: pointer;
    padding: 0.625rem 1rem !important;
    border: 1px solid var(--rc-off-black, #1a1a1a) !important;
    border-radius: 2px !important;
    background: transparent !important;
    transition: all 0.15s;
    display: flex !important;
    align-items: center !important;
    flex: 1;
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 0.875rem !important;
    font-weight: 400 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
  }
  .rc-radio-option input[type="radio"]:checked + label {
    border-color: var(--rc-green, #1e4433) !important;
    background: rgba(30, 68, 51, 0.05) !important;
    color: var(--rc-green, #1e4433) !important;
    font-weight: 500 !important;
  }

  /* Checkbox */
  .rc-checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .rc-checkbox-group input[type="checkbox"] {
    width: 1.25rem;
    height: 1.25rem;
    min-width: 1.25rem;
    margin: 0;
    padding: 0;
    cursor: pointer;
    accent-color: var(--rc-green, #1e4433);
    border: 1px solid var(--rc-off-black, #1a1a1a);
    border-radius: 0.25rem;
    flex-shrink: 0;
  }
  .rc-checkbox-group label {
    margin: 0 !important;
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 0.875rem !important;
    line-height: 1.5 !important;
    cursor: pointer;
    color: var(--rc-off-black, #1a1a1a) !important;
  }
  .rc-checkbox-group a {
    color: var(--rc-off-black, #1a1a1a) !important;
    text-decoration: underline !important;
  }
  .rc-checkbox-group a:hover {
    color: var(--rc-green, #1e4433) !important;
  }

  .rc-form-submit { margin-top: 1.5rem; }
  .rc-form-submit button {
    padding: 0.875rem 2rem;
    background: var(--rc-green, #1e4433);
    color: var(--rc-white, #fff);
    border: none;
    border-radius: var(--rc-radius, 0.5rem);
    font-size: 1rem;
    font-weight: 500;
    font-family: var(--rc-font, 'DM Sans', sans-serif);
    cursor: pointer;
    transition: background 0.2s;
  }
  .rc-form-submit button:hover { background: var(--rc-green-hover, #163a28); }

  /* Success message */
  .rc-form-success {
    display: none;
    text-align: center;
    padding: 2rem 0;
  }
  .rc-form-success__icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--rc-green, #1e4433);
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rc-form-success__icon svg { width: 1.75rem; height: 1.75rem; stroke: var(--rc-white); fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .rc-form-success h4 { font-size: 1.25rem; font-weight: 600; margin: 0 0 0.5rem; }
  .rc-form-success p { font-size: 0.875rem; color: var(--rc-text-muted, #666); margin: 0; }

  @media (max-width: 900px) {
    .rc-contact-page__inner {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
      padding: 0 1.25rem !important;
    }
    .rc-form-row { grid-template-columns: 1fr; }
    .rc-contact-persons { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 600px) {
    .rc-contact-form-wrap { padding: 1.75rem 1.25rem; }
    .rc-radio-grid { grid-template-columns: 1fr; }
  }
</style>

<section class="rc-contact-page">
  <div class="rc-contact-page__inner">
    <!-- Left: Info + contact persons -->
    <div>
      <h2 class="rc-contact-page__info-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="rc-contact-page__info-body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="rc-contact-blocks">
        {%- if section.settings.email != blank -%}
          <div class="rc-contact-block">
            <div class="rc-contact-block__icon">
              <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="rc-contact-block__value"><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></div>
          </div>
        {%- endif -%}

        {%- if section.settings.address != blank -%}
          <div class="rc-contact-block">
            <div class="rc-contact-block__icon">
              <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="rc-contact-block__value">{{ section.settings.address }}</div>
          </div>
        {%- endif -%}
      </div>

      <!-- Contact persons -->
      {%- assign person_blocks = section.blocks | where: "type", "contact_person" -%}
      {%- if person_blocks.size > 0 -%}
        <div class="rc-contact-persons">
          {%- for block in section.blocks -%}
            {%- if block.type == 'contact_person' -%}
              <div class="rc-contact-person" {{ block.shopify_attributes }}>
                {%- if block.settings.photo != blank -%}
                  <div class="rc-contact-person__photo">
                    <img src="{{ block.settings.photo | image_url: width: 300 }}" alt="{{ block.settings.name }}" loading="lazy">
                  </div>
                {%- endif -%}
                <h4 class="rc-contact-person__name">{{ block.settings.name }}</h4>
                <p class="rc-contact-person__title">{{ block.settings.title }}</p>
                {%- if block.settings.phone != blank -%}
                  <p class="rc-contact-person__phone"><a href="tel:{{ block.settings.phone | remove: ' ' | remove: '-' }}">{{ block.settings.phone }}</a></p>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <p class="rc-contact-person__email"><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Right: Form -->
    <div class="rc-contact-form-wrap">
      <h3>{{ section.settings.form_heading | default: 'Skicka ett meddelande' }}</h3>
      <div id="rc-contact-form-container">
        {%- form 'contact', id: 'rc-contact-form' -%}
          <div class="rc-form-row">
            <div class="rc-form-group">
              <label for="ContactFormName">Namn</label>
              <input type="text" id="ContactFormName" name="contact[name]" autocomplete="name" value="{% if customer %}{{ customer.name }}{% endif %}" placeholder="Ditt namn" required>
            </div>
            <div class="rc-form-group">
              <label for="ContactFormCompany">Företag</label>
              <input type="text" id="ContactFormCompany" name="contact[company]" autocomplete="organization" placeholder="Företagets namn" required>
            </div>
          </div>
          <div class="rc-form-row">
            <div class="rc-form-group">
              <label for="ContactFormEmail">Email</label>
              <input type="email" id="ContactFormEmail" name="contact[email]" autocomplete="email" value="{% if customer %}{{ customer.email }}{% endif %}" placeholder="din@email.se" required>
            </div>
            <div class="rc-form-group">
              <label for="ContactFormPhone">Telefonnummer</label>
              <input type="tel" id="ContactFormPhone" name="contact[phone]" autocomplete="tel" placeholder="Ditt telefonnummer" required>
            </div>
          </div>
          <div class="rc-form-group rc-form-group--full">
            <div class="rc-radio-group">
              <div class="rc-radio-group__label">Välj vad du vill ha hjälp med</div>
              <div class="rc-radio-grid">
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp01" name="contact[body_type]" value="Fråga pris">
                  <label for="ContactFormHelp01">Fråga pris</label>
                </div>
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp02" name="contact[body_type]" value="Beställa prov">
                  <label for="ContactFormHelp02">Beställa prov</label>
                </div>
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp03" name="contact[body_type]" value="Inventering">
                  <label for="ContactFormHelp03">Inventering</label>
                </div>
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp04" name="contact[body_type]" value="Föreskriftsfrågor">
                  <label for="ContactFormHelp04">Föreskriftsfrågor</label>
                </div>
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp05" name="contact[body_type]" value="Demontering">
                  <label for="ContactFormHelp05">Demontering</label>
                </div>
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp06" name="contact[body_type]" value="Boka möte">
                  <label for="ContactFormHelp06">Boka möte</label>
                </div>
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp07" name="contact[body_type]" value="Produktfråga">
                  <label for="ContactFormHelp07">Produktfråga</label>
                </div>
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp08" name="contact[body_type]" value="Service & Underhåll">
                  <label for="ContactFormHelp08">Service & Underhåll</label>
                </div>
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp09" name="contact[body_type]" value="Samarbeten">
                  <label for="ContactFormHelp09">Samarbeten</label>
                </div>
                <div class="rc-radio-option">
                  <input type="radio" id="ContactFormHelp10" name="contact[body_type]" value="Annat">
                  <label for="ContactFormHelp10">Annat</label>
                </div>
              </div>
            </div>
          </div>
          <div class="rc-form-group rc-form-group--full">
            <label for="ContactFormMessage">Meddelande</label>
            <textarea id="ContactFormMessage" name="contact[body]" placeholder="Skriv ditt meddelande..." required></textarea>
          </div>
          <div class="rc-checkbox-group">
            <input type="checkbox" id="ContactFormPrivacy" name="contact[privacy]" value="accepted" required>
            <label for="ContactFormPrivacy">Jag accepterar <a href="/pages/integritetspolicy">Integritetspolicyn</a></label>
          </div>
          <div class="rc-form-submit">
            <button type="submit">{{ section.settings.submit_label | default: 'Skicka' }}</button>
          </div>
        {%- endform -%}
      </div>

      {%- if form.posted_successfully? -%}
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            var container = document.getElementById('rc-contact-form-container');
            if (container) {
              container.innerHTML = '<div class="rc-form-success" style="display:block"><div class="rc-form-success__icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div><h4>Tack för ditt meddelande!</h4><p>Vi återkommer till dig så snart som möjligt.</p></div>';
            }
          });
        </script>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "reCarpet Kontakta oss",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Rubrik", "default": "Kontakta oss" },
    { "type": "textarea", "id": "body", "label": "Text" },
    { "type": "text", "id": "email", "label": "E-post" },
    { "type": "text", "id": "address", "label": "Adress" },
    { "type": "text", "id": "form_heading", "label": "Formulärrubrik", "default": "Skicka ett meddelande" },
    { "type": "text", "id": "submit_label", "label": "Knapptext", "default": "Skicka" }
  ],
  "blocks": [
    {
      "type": "contact_person",
      "name": "Kontaktperson",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Foto" },
        { "type": "text", "id": "name", "label": "Namn" },
        { "type": "text", "id": "title", "label": "Titel / Roll" },
        { "type": "text", "id": "phone", "label": "Telefon" },
        { "type": "text", "id": "email", "label": "E-post" }
      ]
    }
  ],
  "presets": [
    {
      "name": "reCarpet Kontakta oss",
      "settings": {
        "heading": "Kontakta oss",
        "email": "info@recarpet.se",
        "form_heading": "Skicka ett meddelande",
        "submit_label": "Skicka"
      }
    }
  ]
}
{% endschema %}
