{% comment %}
  reCarpet Quote / Testimonial
  Stars + quote + author info with optional company logo
  Matches Webflow design: recarpet.se
{% endcomment %}

<style>
  .rc-quote {
    width: 100%;
    padding: var(--rc-section-md) 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rc-quote__container {
    max-width: 50rem;
    width: 100%;
    text-align: center;
  }

  /* Stars */
  .rc-quote__stars {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
  }
  .rc-quote__stars svg {
    width: 28px;
    height: 28px;
  }

  /* Quote text — matches Webflow .heading-style-h5 */
  .rc-quote__text {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    line-height: 140% !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 0 2.5rem !important;
    text-align: center;
    font-style: normal !important;
    /* Kill Dawn blockquote styles */
    border: none !important;
    border-left: none !important;
    padding: 0 !important;
    padding-left: 0 !important;
    quotes: none !important;
  }

  /* Attribution row */
  .rc-quote__attribution {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .rc-quote__author-info {
    text-align: left;
  }

  /* Author name — matches Webflow .text-weight-semibold */
  .rc-quote__author {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin-bottom: 0.125rem;
  }

  .rc-quote__title {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: var(--rc-text-sm, 0.875rem) !important;
    font-weight: 400 !important;
    color: var(--rc-text-muted, #666) !important;
  }

  /* Vertical divider */
  .rc-quote__divider {
    width: 1px !important;
    min-width: 1px !important;
    height: 3rem !important;
    min-height: 3rem !important;
    background: var(--rc-off-black, #1a1a1a) !important;
    opacity: 0.25 !important;
    flex-shrink: 0 !important;
    display: block !important;
  }

  /* Company logo */
  .rc-quote__logo img {
    height: 2.75rem !important;
    width: auto !important;
    display: block !important;
  }
  .rc-quote__logo svg {
    height: 2.75rem !important;
    width: auto !important;
    display: block !important;
  }

  /* Dark text on green background */
  .rc-quote[style*="--rc-green"],
  .rc-quote[style*="#1E4433"] {
    color: white;
  }
  .rc-quote[style*="--rc-green"] .rc-quote__text,
  .rc-quote[style*="#1E4433"] .rc-quote__text {
    color: #fff !important;
  }
  .rc-quote[style*="--rc-green"] .rc-quote__author,
  .rc-quote[style*="#1E4433"] .rc-quote__author {
    color: #fff !important;
  }
  .rc-quote[style*="--rc-green"] .rc-quote__title,
  .rc-quote[style*="#1E4433"] .rc-quote__title {
    color: rgba(255, 255, 255, 0.8) !important;
  }
  .rc-quote[style*="--rc-green"] .rc-quote__divider,
  .rc-quote[style*="#1E4433"] .rc-quote__divider {
    background: #fff;
    opacity: 0.3;
  }
  .rc-quote[style*="--rc-green"] .rc-quote__stars svg,
  .rc-quote[style*="#1E4433"] .rc-quote__stars svg {
    fill: #f5c518;
  }

  @media (max-width: 768px) {
    .rc-quote {
      padding: var(--rc-section-sm, 3rem) 1.25rem;
    }
    .rc-quote__text {
      font-size: var(--rc-text-md) !important;
    }
    .rc-quote__attribution {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .rc-quote__divider {
      display: none !important;
    }
    .rc-quote__author-info {
      text-align: center;
    }
  }
</style>

<div class="rc-quote" style="background-color: {{ section.settings.background_color | default: 'var(--rc-cream, #F6F6F6)' }}">
  <div class="rc-quote__container">
    {%- if section.settings.show_stars -%}
      <div class="rc-quote__stars">
        {%- for i in (1..5) -%}
          <svg viewBox="0 0 24 24" fill="#F5C518" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <blockquote class="rc-quote__text">
      "{{ section.settings.quote_text }}"
    </blockquote>

    <div class="rc-quote__attribution">
      <div class="rc-quote__author-info">
        <div class="rc-quote__author">{{ section.settings.author_name }}</div>
        <div class="rc-quote__title">{{ section.settings.author_title }}</div>
      </div>
      {%- if section.settings.company_logo != blank -%}
        <div class="rc-quote__divider"></div>
        <div class="rc-quote__logo">
          <img src="{{ section.settings.company_logo | image_url: height: 56 }}" alt="{{ section.settings.company_name | default: 'Logo' }}" loading="lazy">
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "RC Quote",
  "settings": [
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Citattext"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Namn"
    },
    {
      "type": "text",
      "id": "author_title",
      "label": "Titel"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Visa stjärnor",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "company_logo",
      "label": "Företagslogotyp"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Företagsnamn (alt-text)",
      "default": "Logo"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Bakgrundsfärg",
      "options": [
        {
          "value": "var(--rc-cream, #F6F6F6)",
          "label": "Cream"
        },
        {
          "value": "#FFFFFF",
          "label": "Vit"
        },
        {
          "value": "var(--rc-green, #1E4433)",
          "label": "Grön"
        }
      ],
      "default": "var(--rc-cream, #F6F6F6)"
    }
  ],
  "presets": [
    {
      "name": "RC Quote"
    }
  ]
}
{% endschema %}
