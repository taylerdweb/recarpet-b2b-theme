{% comment %}
  reCarpet Page Hero
  Dark overlay hero for interior pages (Vad vi gör, Om oss, etc.)
  Layout: eyebrow + H1 left, rich-text body right (two-column grid)
{% endcomment %}

<style>
  .rc-page-hero {
    position: relative;
    min-height: 32rem;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    /* Override Dawn's foreground color so inherited styles render white */
    --color-foreground: 255, 255, 255;
  }
  .rc-page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .rc-page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position | default: 'center center' }};
  }
  .rc-page-hero--no-image .rc-page-hero__bg {
    background: var(--rc-green);
  }
  /* Dark overlay via ::after — bulletproof against external style interference */
  .rc-page-hero::after {
    content: '' !important;
    position: absolute !important;
    inset: 0 !important;
    background: rgba(0,0,0,0.5) !important;
    z-index: 1 !important;
    pointer-events: none;
  }
  .rc-page-hero--no-image::after {
    display: none !important;
  }
  .rc-page-hero__content {
    position: relative;
    z-index: 2;
    max-width: var(--rc-max-width);
    margin: 0 auto;
    padding: var(--rc-section-md) var(--rc-page-padding);
    width: 100%;
    color: #fff !important;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: end;
  }
  /* Left column: eyebrow + heading */
  .rc-page-hero__left {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .rc-page-hero__eyebrow {
    font-family: var(--rc-font) !important;
    font-size: var(--rc-text-sm) !important;
    font-weight: 600 !important;
    color: rgba(255,255,255,0.7) !important;
    margin-bottom: 0.75rem;
    display: inline-block;
    line-height: var(--rc-body-lh, 1.5);
  }
  .rc-page-hero__heading {
    font-size: clamp(1.875rem, 4.5vw, var(--rc-h1));
    font-weight: 500;
    line-height: 1.1;
    color: #fff !important;
    margin: 0;
  }
  /* Right column: rich-text body */
  .rc-page-hero__body {
    align-self: end;
  }
  .rc-page-hero__body p {
    font-family: var(--rc-font) !important;
    font-size: 1.25rem !important;
    line-height: 1.6 !important;
    color: rgba(255,255,255,0.85) !important;
    margin: 0 0 1.25rem !important;
  }
  .rc-page-hero__body p:last-child {
    margin-bottom: 0 !important;
  }
  @media (max-width: 768px) {
    .rc-page-hero__content {
      padding: 2.5rem 1.25rem;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .rc-page-hero { min-height: 22rem; }
  }
</style>

<section class="rc-page-hero{% if section.settings.background_image == blank %} rc-page-hero--no-image{% endif %}">
  <div class="rc-page-hero__bg">
    {%- if section.settings.background_image != blank -%}
      {{ section.settings.background_image | image_url: width: 1920 | image_tag: loading: 'eager', sizes: '100vw' }}
    {%- endif -%}
  </div>
  <div class="rc-page-hero__content">
    <div class="rc-page-hero__left">
      {%- if section.settings.eyebrow != blank -%}
        <span class="rc-page-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="rc-page-hero__heading">{{ section.settings.heading | default: page.title }}</h1>
    </div>
    {%- if section.settings.body != blank -%}
      <div class="rc-page-hero__body">{{ section.settings.body }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "reCarpet Sidhero",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Bakgrundsbild"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Bildposition",
      "options": [
        { "value": "center center", "label": "Mitten" },
        { "value": "top center", "label": "Topp" },
        { "value": "bottom center", "label": "Botten" }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Liten text (tagg)"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Rubrik (tom = sidans titel)"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Brödtext (högerkolumn)"
    }
  ],
  "presets": [
    {
      "name": "reCarpet Sidhero"
    }
  ]
}
{% endschema %}
