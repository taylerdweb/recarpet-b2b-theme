{% comment %}
  reCarpet Vad vi gör — Services overview + detail sections
  Used on /pages/vad-vi-gor (Tjänster page)
{% endcomment %}

<style>
  /* ===== Timeline navigation ===== */
  .rc-timeline-nav {
    background: var(--rc-cream, #f5f3ef);
    padding: var(--rc-section-md) var(--rc-page-padding);
  }
  .rc-timeline-nav__inner {
    max-width: var(--rc-max-width);
    margin: 0 auto;
  }
  .rc-timeline-nav__track {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: auto 2rem auto;
    position: relative;
  }
  /* Horizontal connecting line — fades out at the right */
  .rc-timeline-nav__track::before {
    content: '';
    grid-row: 2;
    grid-column: 1 / -1;
    height: 3px;
    background: linear-gradient(to right, var(--rc-off-black, #1a1a1a) 80%, transparent 100%);
    align-self: center;
    z-index: 1;
  }
  /* Top text (odd items: 1,3,5) */
  .rc-timeline-nav__text--top {
    grid-row: 1;
    align-self: end;
    padding-bottom: 1.25rem;
  }
  /* Bottom text (even items: 2,4,6) */
  .rc-timeline-nav__text--bottom {
    grid-row: 3;
    align-self: start;
    padding-top: 1.25rem;
  }
  .rc-timeline-nav__link {
    text-decoration: none;
    display: block;
  }
  .rc-timeline-nav__link:hover .rc-timeline-nav__title {
    color: var(--rc-green, #1e4433);
  }
  .rc-timeline-nav__title {
    font-family: var(--rc-font);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 600;
    color: var(--rc-off-black, #1a1a1a);
    margin-bottom: 0.375rem;
    line-height: 1.3;
    transition: color 0.2s;
  }
  .rc-timeline-nav__desc {
    font-family: var(--rc-font);
    font-size: var(--rc-text-sm, 0.875rem);
    color: var(--rc-text-muted, #666);
    line-height: 1.5;
    max-width: 15rem;
  }
  /* Dot cells */
  .rc-timeline-nav__dot-cell {
    grid-row: 2;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .rc-timeline-nav__dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--rc-green-muted, #8ba99a);
    display: block;
    flex-shrink: 0;
    transition: transform 0.15s;
  }
  .rc-timeline-nav__dot:hover {
    transform: scale(1.3);
  }

  /* ===== Service detail section ===== */
  .rc-service-detail {
    padding: var(--rc-section-md) 0;
    background: var(--rc-cream, #f5f3ef);
  }
  .rc-service-detail__inner {
    max-width: var(--rc-max-width);
    margin: 0 auto;
    padding: 0 var(--rc-page-padding);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5.5rem;
    align-items: center;
  }
  .rc-service-detail__eyebrow {
    font-family: var(--rc-font) !important;
    font-size: var(--rc-text-sm, 0.875rem) !important;
    font-weight: 600 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin-bottom: 0.5rem;
    display: inline-block;
    line-height: var(--rc-body-lh, 1.5);
  }
  .rc-service-detail__heading {
    font-size: clamp(1.5rem, 3vw, var(--rc-h3));
    font-weight: 500;
    color: var(--rc-text);
    margin: 0 0 1.5rem;
  }
  .rc-service-detail__body {
    font-size: var(--rc-text-base);
    line-height: 1.75;
    color: var(--rc-text-muted);
    margin: 1rem 0 0.75rem;
  }
  .rc-service-detail__list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .rc-service-detail__list li {
    font-size: var(--rc-text-sm);
    color: var(--rc-text-muted);
    padding-left: 1.75rem;
    position: relative;
  }
  .rc-service-detail__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.25em;
    width: 16px;
    height: 17px;
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='17' viewBox='0 0 16 17' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7.52867 12.0288L8.47133 12.9715L12.9427 8.50014L8.47133 4.02881L7.52867 4.97147L10.3907 7.83348H4V9.16681H10.3907L7.52867 12.0288Z' fill='%231E4433'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-size: contain;
  }
  .rc-service-detail__body-after {
    font-size: var(--rc-text-base);
    line-height: 1.75;
    color: var(--rc-text-muted);
    margin: 0 0 1.5rem;
  }
  .rc-service-detail__image { border-radius: var(--rc-radius); overflow: hidden; aspect-ratio: 4/3; }
  .rc-service-detail__image img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 900px) {
    /* Timeline mobile — vertical list */
    .rc-timeline-nav {
      padding: 2rem 1.25rem;
    }
    .rc-timeline-nav__track {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .rc-timeline-nav__track::before { display: none; }
    .rc-timeline-nav__dot-cell { display: none; }
    .rc-timeline-nav__text--top,
    .rc-timeline-nav__text--bottom {
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(0,0,0,0.08);
    }
    /* Service detail mobile */
    .rc-service-detail__inner { grid-template-columns: 1fr; gap: 2rem; }
    .rc-service-detail__inner { padding: 0 1.25rem; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Smooth scroll when clicking timeline links
    document.querySelectorAll('.rc-timeline-nav__link, .rc-timeline-nav__dot').forEach(function(el) {
      el.addEventListener('click', function(e) {
        var anchor = this.getAttribute('href');
        if (anchor && anchor.startsWith('#')) {
          e.preventDefault();
          var target = document.querySelector('[data-service-section="' + anchor.substring(1) + '"]');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  });
</script>

<!-- Timeline navigation -->
<nav class="rc-timeline-nav" aria-label="Tjänster">
  <div class="rc-timeline-nav__inner">
    <div class="rc-timeline-nav__track">
      {%- for block in section.blocks -%}
        {%- assign mod = forloop.index | modulo: 2 -%}
        <div class="rc-timeline-nav__text {% if mod == 1 %}rc-timeline-nav__text--top{% else %}rc-timeline-nav__text--bottom{% endif %}" style="grid-column: {{ forloop.index }}">
          <a href="#{{ block.settings.anchor }}" class="rc-timeline-nav__link">
            <div class="rc-timeline-nav__title">{{ block.settings.eyebrow }}</div>
            {%- if block.settings.nav_desc != blank -%}
              <div class="rc-timeline-nav__desc">{{ block.settings.nav_desc }}</div>
            {%- endif -%}
          </a>
        </div>
        <div class="rc-timeline-nav__dot-cell" style="grid-column: {{ forloop.index }}">
          <a href="#{{ block.settings.anchor }}" class="rc-timeline-nav__dot" aria-label="{{ block.settings.eyebrow }}"></a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</nav>

<!-- Service detail blocks -->
{%- for block in section.blocks -%}
  <section
    class="rc-service-detail"
    id="{{ block.settings.anchor | default: block.settings.title | downcase | replace: ' ', '-' }}"
    data-service-section="{{ block.settings.anchor | default: block.settings.title | downcase | replace: ' ', '-' }}"
  >
    <div class="rc-service-detail__inner">
      <div class="rc-service-detail__text">
        {%- if block.settings.eyebrow != blank -%}
          <span class="rc-service-detail__eyebrow">{{ block.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="rc-service-detail__heading">{{ block.settings.title }}</h2>
        <p class="rc-service-detail__body">{{ block.settings.body }}</p>
        {%- if block.settings.list != blank -%}
          <ul class="rc-service-detail__list">
            {%- assign items = block.settings.list | newline_to_br | split: '<br />' -%}
            {%- for item in items -%}
              {%- if item != blank -%}<li>{{ item | strip }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if block.settings.body_after != blank -%}
          <p class="rc-service-detail__body-after">{{ block.settings.body_after }}</p>
        {%- endif -%}
        {%- if block.settings.btn_label != blank -%}
          <a href="{{ block.settings.btn_url | default: '/pages/kontakta-oss' }}" class="rc-btn rc-btn--outline">{{ block.settings.btn_label }}</a>
        {%- endif -%}
      </div>
      <div class="rc-service-detail__image">
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title }}" loading="lazy">
        {%- else -%}
          <div style="background:var(--rc-cream-alt);height:100%;min-height:260px;"></div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endfor -%}

