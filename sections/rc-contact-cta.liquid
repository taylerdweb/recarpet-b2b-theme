{% comment %}
  reCarpet Contact CTA
  "Vill du cirkulera golv?" — full-width CTA section before footer
{% endcomment %}

<style>
  .rc-contact-cta {
    background: var(--rc-white);
    padding: var(--rc-section-lg, 7rem) 0;
  }
  .rc-contact-cta__inner {
    max-width: var(--rc-max-width);
    margin: 0 auto;
    padding: 0 var(--rc-page-padding);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .rc-contact-cta__heading {
    font-family: var(--rc-font);
    font-size: clamp(1.75rem, 3.5vw, var(--rc-h2));
    font-weight: 500;
    line-height: 1.15;
    color: var(--rc-text);
    margin: 0;
  }
  .rc-contact-cta__body {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1.25rem !important;
    line-height: 1.65 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 0 1.75rem !important;
  }
  .rc-contact-cta__body p {
    font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
    font-size: 1.25rem !important;
    line-height: 1.65 !important;
    color: var(--rc-off-black, #1a1a1a) !important;
    margin: 0 0 1rem !important;
  }
  .rc-contact-cta__body p:last-child {
    margin: 0 !important;
  }
  .rc-contact-cta__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 768px) {
    .rc-contact-cta__inner {
      grid-template-columns: 1fr;
      padding: 0 1.25rem;
      gap: 1.5rem;
    }
    .rc-contact-cta { padding: var(--rc-section-sm) 0; }
    .rc-contact-cta__body,
    .rc-contact-cta__body p {
      font-size: 1rem !important;
      line-height: 1.5 !important;
    }
  }
</style>

<section class="rc-contact-cta">
  <div class="rc-contact-cta__inner">
    <h2 class="rc-contact-cta__heading">{{ section.settings.heading }}</h2>
    <div>
      {%- if section.settings.body != blank -%}
        <div class="rc-contact-cta__body">{{ section.settings.body }}</div>
      {%- endif -%}
      <div class="rc-contact-cta__actions">
        {%- if section.settings.btn1_label != blank -%}
          <a href="{{ section.settings.btn1_url }}" class="rc-btn rc-btn--primary">{{ section.settings.btn1_label }}</a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_url }}" class="rc-btn rc-btn--outline">{{ section.settings.btn2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "reCarpet Kontakt CTA",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Rubrik",
      "default": "Vill du cirkulera golv?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Knapp 1 text",
      "default": "Kontakta oss"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Knapp 1 länk"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Knapp 2 text"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Knapp 2 länk"
    }
  ],
  "presets": [
    {
      "name": "reCarpet Kontakt CTA",
      "settings": {
        "heading": "Vill du cirkulera golv?",
        "btn1_label": "Kontakta oss",
        "btn1_url": "/pages/kontakta-oss"
      }
    }
  ]
}
{% endschema %}
