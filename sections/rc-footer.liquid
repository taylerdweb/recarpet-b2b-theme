{% comment %}
  reCarpet Custom Footer
  Dark green, dynamic columns via blocks (column + link)
{% endcomment %}

<style>
  .rc-footer {
    background: var(--rc-green);
    color: rgba(255,255,255,0.85);
    padding: var(--rc-section-md) 0 0;
    font-family: var(--rc-font);
  }
  .rc-footer__inner {
    max-width: var(--rc-max-width);
    margin: 0 auto;
    padding: 0 var(--rc-page-padding);
    display: grid;
    grid-template-columns: 1.5fr repeat(var(--rc-footer-cols, 4), 1fr);
    column-gap: 3rem;
    row-gap: 3rem;
  }
  /* Logo column */
  .rc-footer__brand { padding-right: 2rem; }
  .rc-footer__logo {
    color: #fff;
    font-size: 1.375rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    display: block;
  }
  .rc-footer__logo img,
  .rc-footer__logo svg { height: 2.5rem; width: auto; }

  .rc-footer__contact p {
    font-size: var(--rc-text-sm);
    color: rgba(255,255,255,0.75);
    margin: 0 0 0.25rem;
    line-height: 1.5;
  }
  .rc-footer__contact a {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
  }
  .rc-footer__contact a:hover { color: #fff; text-decoration: underline; }
  .rc-footer h2.rc-footer__contact-label {
    font-size: var(--rc-text-base);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: #fff;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    margin-top: 2.5rem;
  }

  /* Nav columns */
  .rc-footer h2.rc-footer__col-title {
    font-size: var(--rc-text-base);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: #fff;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }
  .rc-footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .rc-footer__nav a {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
    font-size: 0.875rem;
    color: var(--base-color-brand--rc-white, #f6f6f6);
    text-decoration: none;
    line-height: 1.5;
  }
  .rc-footer__nav a:hover { color: #fff; text-decoration: underline; }

  /* Bottom bar */
  .rc-footer__bottom {
    grid-column: 1 / -1;
    margin-top: var(--rc-section-sm);
    padding: 2rem 0 4rem;
    border-top: 1px solid var(--base-color-brand--rc-white, #f6f6f6);
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .rc-footer__copyright {
    font-size: var(--rc-text-sm);
    color: #fff;
  }
  .rc-footer__legal {
    display: flex;
    gap: 1.25rem;
  }
  .rc-footer__legal a {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
    font-size: var(--rc-text-sm);
    color: #fff;
    text-decoration: underline;
  }
  .rc-footer__legal a:hover { color: rgba(255,255,255,0.75); }

  @media (max-width: 1000px) {
    .rc-footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .rc-footer__brand { grid-column: 1 / -1; padding-right: 0; }
  }
  @media (max-width: 600px) {
    .rc-footer__inner { grid-template-columns: 1fr; padding: 0 1.25rem; }
    .rc-footer__bottom { padding: 1.25rem 1.25rem; flex-direction: column; align-items: flex-start; }
    .rc-footer__copyright,
    .rc-footer__legal a {
      font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
      font-size: 0.875rem !important;
      line-height: 1.5 !important;
    }
  }
  @media (max-width: 768px) {
    .rc-footer__copyright,
    .rc-footer__legal a {
      font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
      font-size: 0.875rem !important;
      line-height: 1.5 !important;
    }
  }
</style>

{%- comment -%}
  Count how many column blocks we have so we can set the grid columns
{%- endcomment -%}
{%- assign col_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'column' -%}
    {%- assign col_count = col_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<footer class="rc-footer" role="contentinfo" style="--rc-footer-cols: {{ col_count | default: 4 }}">
  <div class="rc-footer__inner">

    <!-- Brand column -->
    <div class="rc-footer__brand">
      <a href="/" class="rc-footer__logo">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 520 80" role="img" aria-label="{{ shop.name }}">
            <text x="0" y="60" font-family="'DM Sans', sans-serif" font-size="64" font-weight="500" fill="#ffffff" letter-spacing="-1">ReCarpet</text>
          </svg>
        {%- endif -%}
      </a>

      <h2 class="rc-footer__contact-label">Kontakt</h2>
      <div class="rc-footer__contact">
        {%- if section.settings.phone != blank -%}
          <p><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></p>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <p style="margin-top:0.5rem;font-size:0.8125rem;">{{ section.settings.address }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}
      Render columns dynamically from blocks.
      A "column" block starts a new <div>, and all following "link" blocks
      become <li> items inside that column until the next "column" block.
    {%- endcomment -%}
    {%- assign col_open = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'column' -%}
        {%- if col_open -%}
              </ul>
            </div>
        {%- endif -%}
            <div class="rc-footer__col" {{ block.shopify_attributes }}>
              <h2 class="rc-footer__col-title">{{ block.settings.title }}</h2>
              <ul class="rc-footer__nav">
        {%- assign col_open = true -%}
      {%- elsif block.type == 'link' -%}
        {%- if col_open -%}
                <li {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.url }}"
                    {%- if block.settings.new_tab %} target="_blank" rel="noopener nofollow"{% endif -%}
                  >{{ block.settings.label }}</a>
                </li>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if col_open -%}
          </ul>
        </div>
    {%- endif -%}

    <!-- Bottom bar -->
    <div class="rc-footer__bottom">
      <span class="rc-footer__copyright">&copy; {{ 'now' | date: '%Y' }} ReCarpet</span>
      <div class="rc-footer__legal">
        {%- if section.settings.legal_1_label != blank -%}
          <a href="{{ section.settings.legal_1_url }}">{{ section.settings.legal_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.legal_2_label != blank -%}
          <a href="{{ section.settings.legal_2_url }}">{{ section.settings.legal_2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "reCarpet Footer",
  "tag": "div",
  "class": "rc-footer-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logotyp (vit, för mörk bakgrund)"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefon",
      "default": "0700733682"
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-post",
      "default": "jonas@recarpet.se"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Adress"
    },
    {
      "type": "header",
      "content": "Juridiska länkar (botten)"
    },
    {
      "type": "text",
      "id": "legal_1_label",
      "label": "Länk 1 text",
      "default": "Integritetspolicy"
    },
    {
      "type": "text",
      "id": "legal_1_url",
      "label": "Länk 1 URL",
      "default": "/pages/integritetspolicy"
    },
    {
      "type": "text",
      "id": "legal_2_label",
      "label": "Länk 2 text",
      "default": "Köpvillkor"
    },
    {
      "type": "text",
      "id": "legal_2_url",
      "label": "Länk 2 URL",
      "default": "/pages/kopvillkor"
    }
  ],
  "max_blocks": 30,
  "blocks": [
    {
      "type": "column",
      "name": "Kolumn",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Kolumnrubrik",
          "default": "Kolumn"
        }
      ]
    },
    {
      "type": "link",
      "name": "Länk",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Länktext",
          "default": "Länk"
        },
        {
          "type": "text",
          "id": "url",
          "label": "URL (t.ex. /pages/om-oss eller /pages/vara-kunder#fastighetsagare)"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Öppna i ny flik",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "reCarpet Footer",
      "settings": {
        "phone": "0700733682",
        "email": "jonas@recarpet.se",
        "legal_1_label": "Integritetspolicy",
        "legal_1_url": "/pages/integritetspolicy",
        "legal_2_label": "Köpvillkor",
        "legal_2_url": "/pages/kopvillkor"
      },
      "blocks": [
        { "type": "column", "settings": { "title": "Våra kunder" } },
        { "type": "link", "settings": { "label": "Fastighetsägare", "url": "/pages/vara-kunder#fastighetsagare" } },
        { "type": "link", "settings": { "label": "Arkitekt", "url": "/pages/vara-kunder#arkitekter" } },
        { "type": "link", "settings": { "label": "Hyresgäst", "url": "/pages/vara-kunder#hyresgaster" } },
        { "type": "link", "settings": { "label": "Entreprenör", "url": "/pages/vara-kunder#entreprenorer" } },
        { "type": "column", "settings": { "title": "Vad vi gör" } },
        { "type": "link", "settings": { "label": "Inventering", "url": "/pages/vad-vi-gor#inventering" } },
        { "type": "link", "settings": { "label": "Demontering", "url": "/pages/vad-vi-gor#demontering" } },
        { "type": "link", "settings": { "label": "Förmedling", "url": "/pages/vad-vi-gor#formedling" } },
        { "type": "link", "settings": { "label": "Montering", "url": "/pages/vad-vi-gor#montering" } },
        { "type": "link", "settings": { "label": "Service & underhåll", "url": "/pages/vad-vi-gor#service" } },
        { "type": "link", "settings": { "label": "Internt återbruk", "url": "/pages/vad-vi-gor#internt-aterbruk" } },
        { "type": "column", "settings": { "title": "Våra golv" } },
        { "type": "link", "settings": { "label": "Återbrukade textilplattor", "url": "/collections/aterbrukade-textilplattor" } },
        { "type": "link", "settings": { "label": "Milliken textilplattor", "url": "/collections/nya-textilplattor" } },
        { "type": "link", "settings": { "label": "Alla produkter", "url": "/collections/all" } },
        { "type": "column", "settings": { "title": "Kontakta ReCarpet" } },
        { "type": "link", "settings": { "label": "Kontakta oss", "url": "/pages/kontakta-oss" } },
        { "type": "link", "settings": { "label": "Om oss", "url": "/pages/om-oss" } },
        { "type": "link", "settings": { "label": "Logga in B2B", "url": "/account/login" } }
      ]
    }
  ]
}
{% endschema %}
