{% comment %}
  reCarpet Custom Footer
  Dark green, 4-column layout matching old site design
{% endcomment %}

<style>
  .rc-footer {
    background: var(--rc-green);
    color: rgba(255,255,255,0.85);
    padding: var(--rc-section-md) 0 0;
    font-family: var(--rc-font);
  }
  .rc-footer__inner {
    max-width: var(--rc-max-width);
    margin: 0 auto;
    padding: 0 var(--rc-page-padding);
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    column-gap: 3rem;
    row-gap: 3rem;
  }
  /* Logo column */
  .rc-footer__brand { padding-right: 2rem; }
  .rc-footer__logo {
    color: #fff;
    font-size: 1.375rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    display: block;
  }
  .rc-footer__logo img,
  .rc-footer__logo svg { height: 2.5rem; width: auto; }

  .rc-footer__contact p {
    font-size: var(--rc-text-sm);
    color: rgba(255,255,255,0.75);
    margin: 0 0 0.25rem;
    line-height: 1.5;
  }
  .rc-footer__contact a {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
  }
  .rc-footer__contact a:hover { color: #fff; text-decoration: underline; }
  .rc-footer h2.rc-footer__contact-label {
    font-size: var(--rc-text-base);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: #fff;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    margin-top: 2.5rem;
  }

  /* Nav columns */
  .rc-footer h2.rc-footer__col-title {
    font-size: var(--rc-text-base);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: #fff;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }
  .rc-footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .rc-footer__nav a {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
    font-size: 0.875rem;
    color: var(--base-color-brand--rc-white, #f6f6f6);
    text-decoration: none;
    line-height: 1.5;
  }

  /* Bottom bar */
  .rc-footer__bottom {
    grid-column: 1 / -1;
    margin-top: var(--rc-section-sm);
    padding: 2rem 0 4rem;
    border-top: 1px solid var(--base-color-brand--rc-white, #f6f6f6);
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .rc-footer__copyright {
    font-size: var(--rc-text-sm);
    color: #fff;
  }
  .rc-footer__legal {
    display: flex;
    gap: 1.25rem;
  }
  .rc-footer__legal a {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
    font-size: var(--rc-text-sm);
    color: #fff;
    text-decoration: underline;
  }
  .rc-footer__legal a:hover { color: rgba(255,255,255,0.75); }

  @media (max-width: 1000px) {
    .rc-footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .rc-footer__brand { grid-column: 1 / -1; padding-right: 0; }
  }
  @media (max-width: 600px) {
    .rc-footer__inner { grid-template-columns: 1fr; padding: 0 1.25rem; }
    .rc-footer__bottom { padding: 1.25rem 1.25rem; flex-direction: column; align-items: flex-start; }
    .rc-footer__copyright,
    .rc-footer__legal a {
      font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
      font-size: 0.875rem !important;
      line-height: 1.5 !important;
    }
  }
  @media (max-width: 768px) {
    .rc-footer__copyright,
    .rc-footer__legal a {
      font-family: var(--rc-font, 'DM Sans', sans-serif) !important;
      font-size: 0.875rem !important;
      line-height: 1.5 !important;
    }
  }
</style>

<footer class="rc-footer" role="contentinfo">
  <div class="rc-footer__inner">

    <!-- Brand column -->
    <div class="rc-footer__brand">
      <a href="/" class="rc-footer__logo">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 520 80" role="img" aria-label="{{ shop.name }}">
            <text x="0" y="60" font-family="'DM Sans', sans-serif" font-size="64" font-weight="500" fill="#ffffff" letter-spacing="-1">ReCarpet</text>
          </svg>
        {%- endif -%}
      </a>



      <h2 class="rc-footer__contact-label">Kontakt</h2>
      <div class="rc-footer__contact">
        {%- if section.settings.phone != blank -%}
          <p><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></p>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <p style="margin-top:0.5rem;font-size:0.8125rem;">{{ section.settings.address }}</p>
        {%- endif -%}
      </div>
    </div>

    <!-- Våra kunder -->
    <div class="rc-footer__col">
      <h2 class="rc-footer__col-title">Våra kunder</h2>
      <ul class="rc-footer__nav">
        <li><a href="/pages/fastighetsagare">Fastighetsägare</a></li>
        <li><a href="/pages/arkitekter">Arkitekt</a></li>
        <li><a href="/pages/hyresgast">Hyresgäst</a></li>
        <li><a href="/pages/entreprenor">Entreprenör</a></li>
      </ul>
    </div>

    <!-- Vad vi gör -->
    <div class="rc-footer__col">
      <h2 class="rc-footer__col-title">Vad vi gör</h2>
      <ul class="rc-footer__nav">
        <li><a href="/pages/vad-vi-gor#inventering">Inventering</a></li>
        <li><a href="/pages/vad-vi-gor#demontering">Demontering</a></li>
        <li><a href="/pages/vad-vi-gor#formedling">Förmedling</a></li>
        <li><a href="/pages/vad-vi-gor#montering">Montering</a></li>
        <li><a href="/pages/vad-vi-gor#service">Service & underhåll</a></li>
        <li><a href="/pages/vad-vi-gor#internt-aterbruk">Internt återbruk</a></li>
      </ul>
    </div>

    <!-- Våra golv -->
    <div class="rc-footer__col">
      <h2 class="rc-footer__col-title">Våra golv</h2>
      <ul class="rc-footer__nav">
        <li><a href="/collections/aterbrukade-textilplattor">Återbrukade textilplattor</a></li>
        <li><a href="/collections/nya-textilplattor">Milliken textilplattor</a></li>
        <li><a href="/collections/all">Alla produkter</a></li>
      </ul>
    </div>

    <!-- Kontakta ReCarpet -->
    <div class="rc-footer__col">
      <h2 class="rc-footer__col-title">Kontakta ReCarpet</h2>
      <ul class="rc-footer__nav">
        <li><a href="/pages/kontakta-oss">Kontakta oss</a></li>
        <li><a href="/pages/om-oss">Om oss</a></li>
        <li><a href="{{ routes.account_login_url }}">Logga in B2B</a></li>
        {%- if section.settings.linkedin_url != blank -%}
          <li><a href="{{ section.settings.linkedin_url }}" target="_blank" rel="noopener nofollow">LinkedIn ReCarpet</a></li>
        {%- endif -%}
        {%- if section.settings.linkedin_jonas != blank -%}
          <li><a href="{{ section.settings.linkedin_jonas }}" target="_blank" rel="noopener nofollow">LinkedIn Jonas</a></li>
        {%- endif -%}
      </ul>
    </div>

    <!-- Bottom bar -->
    <div class="rc-footer__bottom">
      <span class="rc-footer__copyright">&copy; {{ 'now' | date: '%Y' }} ReCarpet</span>
      <div class="rc-footer__legal">
        <a href="/pages/integritetspolicy">Integritetspolicy</a>
        <a href="/pages/kopvillkor">Köpvillkor</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "reCarpet Footer",
  "tag": "div",
  "class": "rc-footer-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logotyp (vit, för mörk bakgrund)"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefon",
      "default": "0700733682"
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-post",
      "default": "jonas@recarpet.se"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Adress"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn ReCarpet URL"
    },
    {
      "type": "url",
      "id": "linkedin_jonas",
      "label": "LinkedIn Jonas URL"
    }
  ],
  "presets": [
    {
      "name": "reCarpet Footer"
    }
  ]
}
{% endschema %}
